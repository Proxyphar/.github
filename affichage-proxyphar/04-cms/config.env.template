## /opt/affichage/config.env — configuration Xibo CMS PROXYPHAR
## Généré par 04-cms/installer-cms.sh — droits 600, propriétaire root.
## Ce fichier contient des secrets : ne jamais le copier dans un dépôt ni l'envoyer par e-mail.

## --- Base de données (utilisateur « cms », mot de passe alphanumérique exigé par Xibo) ---
MYSQL_PASSWORD=__MYSQL_PASSWORD__

## --- Nom public du CMS ---
CMS_SERVER_NAME=intranet.proxyphar.fr

## --- Limites d'envoi de fichiers (cohérentes avec Nginx : client_max_body_size 2048m) ---
## Limite retenue : 2 Go par fichier. Voir 09-docs/01-architecture-et-versions.md.
CMS_PHP_POST_MAX_SIZE=2G
CMS_PHP_UPLOAD_MAX_FILESIZE=2G
CMS_PHP_MAX_EXECUTION_TIME=600
CMS_PHP_MEMORY_LIMIT=256M

## --- Sessions (le CMS est servi en HTTPS par Nginx) ---
CMS_PHP_COOKIE_SECURE=On
CMS_PHP_COOKIE_HTTP_ONLY=On
CMS_PHP_COOKIE_SAMESITE=Lax
CMS_PHP_SESSION_GC_MAXLIFETIME=1440

## --- Apache interne ---
CMS_APACHE_SERVER_TOKENS=Prod
CMS_APACHE_TIMEOUT=300

## --- Divers ---
## Pas de rapport d'usage anonyme vers Xibo Signage Ltd.
CMS_USAGE_REPORT=false
## Sauvegarde SQL interne quotidienne (shared/backup/db/latest.sql.gz), en plus de la
## sauvegarde externe du kit (07-sauvegarde).
MYSQL_BACKUP_ENABLED=true
## Exécuteur de tâches interne (XTR) actif.
XTR_ENABLED=true
CMS_QUICK_CHART_URL=http://cms-quickchart:3400

## --- Envoi d'e-mails (alertes, rappels de mot de passe, 2FA par e-mail) ---
## Messagerie PROXYPHAR hébergée chez Google : envoi par smtp.gmail.com avec un
## « mot de passe d'application » créé sur le compte Google expéditeur (validation en
## deux étapes obligatoire). Voir GUIDE-EXECUTION.md, étape 6c. Tant que CMS_SMTP_USERNAME
## vaut « none », le CMS n'envoie rien.
CMS_SMTP_SERVER=smtp.gmail.com:587
CMS_SMTP_USERNAME=none
CMS_SMTP_PASSWORD=none
CMS_SMTP_USE_TLS=YES
CMS_SMTP_USE_STARTTLS=YES
CMS_SMTP_REWRITE_DOMAIN=proxyphar.com
CMS_SMTP_HOSTNAME=intranet.proxyphar.fr
CMS_SMTP_FROM_LINE_OVERRIDE=YES
## Adresse expéditrice : la boîte Google utilisée pour l'authentification (ex. affichage@proxyphar.com)
CMS_SMTP_FROM=none

## --- Comptes du CMS (lignes commentées : lues par les scripts du kit, jamais injectées
##     dans les conteneurs) ---
# AFFICHAGE_CMS_KEY=__AFFICHAGE_CMS_KEY__
# AFFICHAGE_ADMIN_USER=admin_proxyphar
# AFFICHAGE_ADMIN_PASSWORD=__AFFICHAGE_ADMIN_PASSWORD__
# AFFICHAGE_HOTLINE_USER=hotline
# AFFICHAGE_HOTLINE_PASSWORD=__AFFICHAGE_HOTLINE_PASSWORD__
